          "ncnn": "The DETR family is blocked on ncnn framework-wide."
        },
        "segment": {
          "tensorrt": "A published Apache-2.0 trained segmentation checkpoint exports and reloads, but public top-k class membership changes.",
          "openvino": "After Hungarian query alignment, the converted-runtime element match rate is 69.0%, below the validation bar.",
          "tflite": "onnx2tf 2.4.x assigns an invalid NHWC layout to the segmentation-head Einsum (78 channels versus the required 256), so conversion fails."
        },
        "pose": {
          "tensorrt": "A published Apache-2.0 trained pose checkpoint exports and reloads, but matched public boxes fall to 0.704 IoU with 41.4-pixel coordinate drift.",
          "openvino": "After Hungarian query alignment, the converted-runtime element match rate is 72.75%, below the validation bar."
        },
        "obb": {
          "tensorrt": "A deterministic synthetic OBB fixture exports and reloads, but public top-k class membership changes.",
          "openvino": "After Hungarian query alignment, the converted-runtime element match rate is 91.25%, below the validation bar."
        }
